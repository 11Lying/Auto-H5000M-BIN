#!/bin/sh
# Install only the previously verified LAN IPv6 route/firewall guards.
# Deliberately do not touch network WAN, DNS servers, OpenClash, or Wi-Fi UCI.
set -eu

uci -q set firewall.ipv6guard=include
uci -q set firewall.ipv6guard.type='script'
uci -q set firewall.ipv6guard.path='/usr/bin/ipv6-guard.sh'
uci -q set firewall.ipv6guard.enabled='1'

uci -q set firewall.v6fastfail=include
uci -q set firewall.v6fastfail.type='script'
uci -q set firewall.v6fastfail.path='/usr/bin/ipv6-cn-fastfail.sh'
uci -q set firewall.v6fastfail.enabled='1'

# Keep SLAAC-provided LAN IPv6 default routes across odhcpd's V1 checks.
uci -q set dhcp.lan.ra_default='2'
uci -q commit firewall
uci -q commit dhcp

mkdir -p /etc/crontabs
if ! grep -Fq '/usr/bin/ipv6-cn-refresh.sh' /etc/crontabs/root 2>/dev/null; then
	printf '%s\n' '40 4 * * 1 /usr/bin/ipv6-cn-refresh.sh >/dev/null 2>&1' >> /etc/crontabs/root
fi

exit 0
