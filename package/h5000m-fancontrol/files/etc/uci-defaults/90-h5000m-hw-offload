#!/bin/sh
# Enable fw4 nft flow-offload requests for the H5000M MediaTek HNAT path.
# The mtkhnat module owns PPE; hnat-detect maps USB/WWAN external flows/PPD.
uci -q get firewall.@defaults[0] >/dev/null || exit 0
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='1'
# Full-cone remains disabled until separately tested against MT7987 HNAT.
uci set firewall.@defaults[0].fullcone='0'
uci set firewall.@defaults[0].fullcone6='0'
uci commit firewall
exit 0
