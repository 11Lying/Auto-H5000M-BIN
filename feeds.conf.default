# H5000M closed-driver 6.6 build - feeds
#
# Proven combination for the padavanonly/immortalwrt-mt798x-6.6
# mt798x-mt799x-6.6-mtwifi base (same set the upstream existyay build uses).
#
# Reproducibility model changed with the base switch: the *base* is pinned
# to an exact commit (REPO_COMMIT in scripts/local-build.sh); the feeds
# track the branches the base was tested against. local-build.sh still
# verifies every feed line is mirrored before use.
src-git packages https://github.com/immortalwrt/packages.git;openwrt-24.10
src-git luci https://github.com/immortalwrt/luci.git;openwrt-24.10
src-git routing https://github.com/openwrt/routing.git;openwrt-24.10
src-git telephony https://github.com/openwrt/telephony.git;openwrt-24.10
src-git nikki https://github.com/nikkinikki-org/OpenWrt-nikki.git;main
src-git qmodem https://github.com/FUjr/QModem.git;main
