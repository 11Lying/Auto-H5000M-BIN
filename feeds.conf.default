# ============================================================================
# ImmortalWrt 25.12 (openwrt-25.12) 软件源配置 —— H5000M 定制
# 基线：immortalwrt/immortalwrt @ openwrt-25.12（内核 6.12，apk 包管理器）
# ============================================================================

# 核心官方源（跟随 25.12 发布分支）
src-git packages https://github.com/immortalwrt/packages.git;openwrt-25.12
src-git luci https://github.com/immortalwrt/luci.git;openwrt-25.12
src-git routing https://github.com/openwrt/routing.git;openwrt-25.12
src-git telephony https://github.com/openwrt/telephony.git;openwrt-25.12
src-git video https://github.com/openwrt/video.git;openwrt-25.12

# QModem（FUjr/QModem）—— Quectel RM502Q-AE 的面板 + 拨号器 + 厂商 QMI 驱动
#   application/qmodem               主包（qmodem 脚本 + 依赖组装）
#   application/tom_modem            named-semaphore 辅助
#   application/quectel_CM_5G_M      quectel-CM-5G-M（我们用的拨号器）
#   driver/quectel_QMI_WWAN          kmod-qmi_wwan_q（QMAP 数据面）
#   luci/luci-app-qmodem-next        新版 JS 面板
# 由 enable_qmodem 开关控制；关闭时 local-build.sh 会自动删掉这一行。
src-git qmodem https://github.com/FUjr/QModem.git;main

# 注意（25.12 变更）：
#  - 25.12 默认使用 apk 而非 opkg（CONFIG_USE_APK default y）。
#    本仓库的 h5000m-kit 全部资产在构建期直接进镜像，运行期不依赖包管理器；
#    uci-defaults 里没有任何 opkg 调用。
#  - luci-app-openclash 直接来自 immortalwrt/luci（openwrt-25.12），
#    不再走第三方镜像站。
#  - Nikki / MosDNS / PassWall / HomeProxy 一律不引入（用不上，见 extra.config）。
#  - kmod-pcie_mhi（Quectel PCIe MHI）在 25.12 上游不存在，我们走 USB QMI，
#    不再需要（旧 24.10 基座里它来自 padavanonly 的树）。
