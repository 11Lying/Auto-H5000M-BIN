#
# Hiveton H5000M - ImmortalWrt 25.12 pinned chasey-dev/HNAT repair build
#
# This is only a *seed*. scripts/local-build.sh copies it to .config and runs
# `make defconfig`, which expands every dependency and produces the real,
# complete .config. What ships in the firmware is the expanded file, and that
# file is what gets uploaded as a build artifact.
#
# Everything that is NOT listed here stays at the pinned chasey-dev 25.12
# default for this device. The exact source is checked by local-build.sh.
#

#
# --- Target ------------------------------------------------------------------
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_hiveton_h5000m=y
CONFIG_TARGET_PROFILE="DEVICE_hiveton_h5000m"

#
# --- Board drivers and acceleration/data path --------------------------------
# The HNAT module and flow dependencies are explicit package selections;
# they are not all included by the upstream H5000M profile. The final image
# manifest is checked to prevent another compiled-but-unpackaged HNAT driver.
#
# pwm-fan stays a module (kmod-hwmon-pwmfan) with early autoload (971):
# on this board the fan runs at full speed until the driver probes, and the
# 970+972 boot-duty patches keep the probe duty at ~35% instead of 100%.
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_h5000m-fancontrol=y
CONFIG_PACKAGE_kmod-usb3=y
# Explicitly ship the HNAT module. Enabling the kernel symbol alone only
# compiles mtkhnat.ko; it does not place it in the image.
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_hnat-detect=y
CONFIG_PACKAGE_mt7987-2p5g-phy-firmware=y
CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_kmod-mt7992-23-firmware=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_automount=y

#
# --- Performance optimizations -------------------------------------------------
#
# BBR congestion control: better than cubic on variable-latency links (5G).
# The default is applied at first boot via uci-defaults (see
# package/h5000m-fancontrol/files/etc/uci-defaults/): the kernel default
# cannot be set from the seed .config (top-level Kconfig drops raw kernel
# symbols), so sysctl is the supported path.
CONFIG_PACKAGE_kmod-tcp-bbr=y

# Optional kernel crypto/kTLS interfaces. They are not assumed to accelerate
# Mihomo: its Go TLS/crypto path does not automatically use /dev/crypto or kTLS.
# BBR above is the verified TCP transport optimization; forwarded direct flows
# may use HNAT, while TUN proxy processing remains in userspace.
CONFIG_PACKAGE_kmod-cryptodev=y
CONFIG_PACKAGE_kmod-tls=y

# SQM (cake): keeps latency stable when the 5G uplink jitters. Installed but
# not enabled by default; configure per-link speeds in LuCI after flashing.
CONFIG_PACKAGE_luci-app-sqm=y

# SmartDNS: fast parallel DNS resolution. Chain as OpenClash upstream
# (OpenClash DNS -> SmartDNS) so FakeIP hijacking keeps working.
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y

# irqbalance: distribute hardware interrupts across CPU cores.
# Helps WiFi/USB traffic that doesn't go through HNAT.
CONFIG_PACKAGE_irqbalance=y


#
# --- Top-level third-party functionality ---------------------------------------
# OpenClash + QModem are the two main features; SQM (below) is a small
# latency-stability addon for the 5G uplink.
#
# 1) OpenClash 0.47.156 - shipped by the official immortalwrt/luci feed.
#    Its own DEPENDS (dnsmasq-full, bash, curl, ca-bundle, ip-full, ruby,
#    ruby-yaml, kmod-inet-diag, kmod-nft-tproxy, kmod-tun, unzip, luci-compat)
#    are pulled in automatically.
CONFIG_PACKAGE_luci-app-openclash=y

# 2) QModem - JavaScript UI plus its stack. Pulls in qmodem, ubus-at-daemon,
#    tom_modem, modem_scan, sms-tool_q, qmodem-smsd, sms-forwarder-next and the
#    vendor QMI/QMAP driver kmod-qmi_wwan_q.
#    The legacy Lua UI luci-app-qmodem is deliberately NOT selected.
CONFIG_PACKAGE_luci-app-qmodem-next=y

#
# --- Quectel RM502Q-AE data path ---------------------------------------------
# Stated explicitly because these are the packages that must exist for the
# modem to work on this board. They are also QModem dependencies.
#
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-qmi_wwan_q=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_libqmi=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y

#
# --- Build-time only ---------------------------------------------------------
#
# Compiler cache: the CI job caches immortalwrt/.ccache and repeat runs then
# reuse target objects instead of recompiling from zero.
# Build options are only exposed with DEVEL; this only unhides prompts and does
# not change any package or target selection (verified by config diff).
CONFIG_DEVEL=y
CONFIG_CCACHE=y
# The workflow invokes us through scripts/local-build.sh, so this path resolves
# to <checkout>/immortalwrt/.ccache, which is the directory cached in CI.
CONFIG_CCACHE_DIR=""

#
# --- Deliberately excluded ---------------------------------------------------
# Written out so a future edit cannot silently re-enable them.
#
# CONFIG_PACKAGE_modemmanager is not set
# CONFIG_PACKAGE_luci-app-modem is not set
# CONFIG_PACKAGE_luci-app-qmodem is not set
# CONFIG_PACKAGE_luci-app-turboacc-mtk is not set
# CONFIG_PACKAGE_luci-app-Airpifanctrl is not set
# CONFIG_PACKAGE_luci-app-fancontrol is not set
# CONFIG_PACKAGE_luci-app-ramfree is not set
# CONFIG_PACKAGE_luci-app-nikki is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_luci-app-adblock is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set

# bridger is an ImmortalWrt default-on helper that is not part of this device's
# feature set. It is the only thing selecting CONFIG_NEED_BPF_TOOLCHAIN, which
# in turn forces the host LLVM/BPF toolchain to be compiled from source
# (~64 minutes per run on the CI runner). Nothing we ship depends on it.
# CONFIG_PACKAGE_bridger is not set
