#
# Hiveton H5000M - closed-driver performance build (padavanonly 6.6-mtwifi)
#
# This is a *delta* on top of the base defconfig fetched by
# scripts/local-build.sh from the pinned padavanonly commit
# (defconfig/mt7987_mt7992.config). The base already enables the closed
# MediaTek stack (mt_wifi7, mediatek_hnat, mtk_wed, warp, turboacc-mtk,
# mtwifi-cfg, eqos-mtk, tcp-bbr). This file adds the user's own packages,
# the extra optimizations, and explicitly disables what the device profile
# pulls in but this build does not want.
#
# After `make defconfig` the fully expanded .config is what ships; the
# build aborts unless scripts/verify-config.sh passes on it.
#

#
# --- Target ------------------------------------------------------------------
# NOTE: on the padavanonly 6.6 base the device is named with a hyphen.
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_hiveton-h5000m=y
CONFIG_TARGET_PROFILE="DEVICE_hiveton-h5000m"

#
# --- Closed Wi-Fi stack (reaffirmed; already =y in the base defconfig) --------
#
CONFIG_PACKAGE_kmod-mt_wifi_cmn=y
CONFIG_PACKAGE_kmod-mt_wifi7=y
CONFIG_PACKAGE_kmod-mt_hwifi=y
CONFIG_PACKAGE_kmod-mt_wifi_osal=y
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y

#
# --- Closed NAT / wireless offload (reaffirmed) --------------------------------
#
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_kmod-mtk_wed=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y

#
# --- QoS: eqos-mtk (tc-based + mtkhqos_util, from the base) --------------------
#
CONFIG_PACKAGE_luci-app-eqos-mtk=y

#
# --- Congestion control: BBR (base enables the module; make it default) --------
#
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_DEFAULT_TCP_CONG="bbr"

#
# --- Proxy acceleration: EIP-197 via cryptodev + kTLS --------------------------
#
CONFIG_PACKAGE_kmod-cryptodev=y
CONFIG_PACKAGE_kmod-tls=y

#
# --- KPROBES: prerequisite for the qmi_fix_skb USB/WWAN headroom fix -----------
# The qmi_fix_skb.ko module itself is not in the 6.6 base tree and must be
# ported from the whitepaper author's tree (see README). Enabling KPROBES
# now so the module can be dropped in without a kernel rebuild.
#
CONFIG_KERNEL_KPROBES=y

#
# --- The user's own packages ----------------------------------------------------
#
# h5000m-fancontrol: local PWM fan daemon (package/h5000m-fancontrol).
# Replaces luci-app-Airpifanctrl (explicitly disabled below) so only one
# controller ever writes the PWM sysfs node.
CONFIG_PACKAGE_h5000m-fancontrol=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y

# OpenClash (cloned from vernesong/OpenClash by local-build.sh).
CONFIG_PACKAGE_luci-app-openclash=y

# QModem-next: 5G modem management for the user-swappable module
# (Fibocom FM170 / Quectel / ...). Pulls qmodem, ubus-at-daemon,
# tom_modem, modem_scan, sms tools and the vendor QMI driver
# kmod-qmi_wwan_q from the QModem feed.
CONFIG_PACKAGE_luci-app-qmodem-next=y

#
# --- QMI data path (for the USB 5G module) ---------------------------------------
#
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-qmi_wwan_q=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_libqmi=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y

#
# --- Build-time only ------------------------------------------------------------
#
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_CCACHE_DIR=""
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="github.actions"

#
# --- Deliberately disabled -------------------------------------------------------
# The 6.6 device profile (Device/hiveton-h5000m) selects these by default;
# this build overrides them.
#
# Modem: QModem-next replaces the legacy stack (they fight for /dev/cdc-wdm0).
# CONFIG_PACKAGE_luci-app-modem is not set
# CONFIG_PACKAGE_quectel-CM-5G is not set
# CONFIG_PACKAGE_sms-tool is not set
# Fan: h5000m-fancontrol replaces Airpifanctrl (single PWM writer rule).
# CONFIG_PACKAGE_luci-app-Airpifanctrl is not set
# Open Wi-Fi: the closed mt_wifi7 stack is used instead.
# CONFIG_PACKAGE_kmod-mt7996e is not set
# CONFIG_PACKAGE_kmod-mt7992-23-firmware is not set
# TurboACC-SFE: HNAT is the chosen offload engine, not SFE.
# CONFIG_PACKAGE_luci-app-turboacc is not set
