#!/bin/sh
# RM502Q-AE AT 口角色自愈. 学 qmodem/20-modem-usb 的触发方式(DEVPATH+ACTION, 不依赖PRODUCT).
# 在 qmodem add 流程(重写valid_at_ports)之后再跑 map 收窄+建角色.
logger -t rm502q-at "usb_event DEVPATH=${DEVPATH} ACTION=${ACTION}"

# 仅关心 2-1 这个模组槽的 add/bind/remove
case "${DEVPATH}" in
  *2-1|*2-1/*) : ;;
  *) exit 0 ;;
esac
case "${ACTION}" in
  add|bind|remove) : ;;
  *) exit 0 ;;
esac

LOCK=/tmp/rm502q-at-hotplug.lock
LOG=/tmp/rm502q-at-map.log

(
  exec 9>"$LOCK"
  flock -x 9 2>/dev/null

  echo "$(date +%T) hotplug ${ACTION} DEVPATH=${DEVPATH} start" >> "$LOG"

  # 1. 等模组接口枚举(最多15s)
  i=0
  while [ $i -lt 15 ]; do
    [ "$(cat /sys/bus/usb/devices/2-1/idVendor 2>/dev/null)" = "2c7c" ] \
      && [ -d /sys/bus/usb/devices/2-1:1.3 ] && [ -d /sys/bus/usb/devices/2-1:1.2 ] && break
    i=$((i+1)); sleep 1
  done

  # 2. 等 qmodem add 流程结束(它持 /tmp/lock/modem_add_2-1). 最多12s.
  j=0
  while [ $j -lt 12 ]; do
    if lock -n /tmp/lock/modem_add_2-1 2>/dev/null; then
      lock -u /tmp/lock/modem_add_2-1 2>/dev/null
      break
    fi
    j=$((j+1)); sleep 1
  done
  sleep 2

  # 3. 跑 map(收窄 valid_at_ports + 建角色 + 兜底close at-daemon webui口)
  /usr/bin/rm502q-at-map
  RC=$?
  echo "$(date +%T) hotplug ${ACTION} map-rc=$RC q=$(cat /run/rm502q-at/qmodem 2>/dev/null) w=$(cat /run/rm502q-at/webui 2>/dev/null)" >> "$LOG"
) &
exit 0
