#!/bin/sh /etc/rc.common
# fanearly: one-shot early boot PWM initialization for H5000M pwm-fan.
#
# Why: /lib/modules/.../pwm-fan.ko probe (pwm_fan_probe) calls set_pwm(255) as a
# failsafe, driving the fan to 100% duty at module load.  The kernel thermal
# cooling device is registered with the same value, but the fan is only reduced
# later (when the thermal zone's step_wise governor first acts, or when
# /usr/bin/fancontrol takes over at boot+~29s from S99).  Result: fan runs at
# full speed for ~20+s after boot.
#
# What: this runs once, very early (after kmodloader has loaded pwm-fan at the
# S10 boot stage), and writes a safe, low, non-stall PWM value directly to the
# pwm-fan hwmon pwm1 attribute.  The hwmon write path (pwm_fan_write ->
# set_pwm -> pwm_fan_update_state) also recomputes cooling cur_state, so the
# thermal framework stays consistent and STEP_WISE can continue to act normally.
#
# This script is NOT a daemon: it writes once, logs, and exits.  Runtime fan
# control remains owned by the kernel thermal governor and /usr/bin/fancontrol.
#
# Value: 35 is the vendor's own start_speed (uci fancontrol.settings.start_speed)
# and the low plateau of the vendor 'balanced' curve (45-60C -> 35).  i.e. a
# speed the vendor firmware itself considers a valid, safe running speed.
#
# Rollback: /etc/init.d/fanearly disable; rm /etc/init.d/fanearly

START=15

SAFE_PWM=35
TIMEOUT=20

boot() { early_set_pwm; }
start() { early_set_pwm; }

early_set_pwm() {
	local f h name i

	# Locate the pwm-fan hwmon node by its 'name' (robust to hwmon renumbering).
	f="" ; i=0
	while [ $i -lt $TIMEOUT ]; do
		for h in /sys/class/hwmon/hwmon*; do
			[ -r "$h/name" ] || continue
			name=$(cat "$h/name" 2>/dev/null)
			if [ "$name" = "pwmfan" ] && [ -w "$h/pwm1" ]; then
				f="$h/pwm1"
				break
			fi
		done
		[ -n "$f" ] && break
		sleep 1
		i=$((i + 1))
	done

	if [ -z "$f" ]; then
		logger -t fanearly "pwm-fan hwmon not found within ${TIMEOUT}s; skip"
		return 0
	fi

	cur=$(cat "$f" 2>/dev/null)
	echo "$SAFE_PWM" > "$f" 2>/dev/null
	now=$(cat "$f" 2>/dev/null)
	state=$(cat /sys/class/thermal/cooling_device0/cur_state 2>/dev/null)
	logger -t fanearly "early pwm init: ${cur} -> ${now} (safe=${SAFE_PWM}, cur_state=${state})"
	return 0
}
