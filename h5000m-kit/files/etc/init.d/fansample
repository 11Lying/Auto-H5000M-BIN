#!/bin/sh /etc/rc.common
START=14
boot() { sample & }
start() { sample & }
stop() { :; }
sample() {
	i=0
	: > /tmp/fan-boot.log
	while [ $i -lt 90 ]; do
		up=$(cut -d. -f1 /proc/uptime)
		h=""
		for x in /sys/class/hwmon/hwmon*; do [ "$(cat "$x/name" 2>/dev/null)" = pwmfan ] && h=$x; done
		pwm=$(cat "$h/pwm1" 2>/dev/null)
		t=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
		st=$(cat /sys/class/thermal/cooling_device0/cur_state 2>/dev/null)
		pol=$(cat /sys/class/thermal/thermal_zone0/policy 2>/dev/null)
		echo "up=${up}s pwm=${pwm} temp=${t} cstate=${st} policy=${pol}" >> /tmp/fan-boot.log
		sleep 1; i=$((i+1))
	done
}
