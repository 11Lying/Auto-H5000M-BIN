#!/bin/sh /etc/rc.common
# RM502Q AT 角色映射初始化: 在 qmodem 扫描(80)后、at-daemon/webui(99)前建立角色
START=85
STOP=15
USE_PROCD=1

_do_map_when_ready() {
  ( i=0
    # 等模组枚举
    while [ $i -lt 25 ]; do
      if [ "$(cat /sys/bus/usb/devices/2-1/idVendor 2>/dev/null)" = "2c7c" ] \
         && [ -d /sys/bus/usb/devices/2-1:1.3 ] && [ -d /sys/bus/usb/devices/2-1:1.2 ]; then
        break
      fi
      i=$((i+1)); sleep 1
    done
    # 等 qmodem add 流程锁释放(最多12s), 避免它随后覆盖 valid
    j=0
    while [ $j -lt 12 ]; do
      if lock -n /tmp/lock/modem_add_2-1 2>/dev/null; then
        lock -u /tmp/lock/modem_add_2-1 2>/dev/null; break
      fi
      j=$((j+1)); sleep 1
    done
    sleep 2
    # 跑 map, 若首次未收窄成功则再重试几次(应对 qmodem 延迟扫描覆盖)
    k=0
    while [ $k -lt 5 ]; do
      /usr/bin/rm502q-at-map
      v=$(uci -q get qmodem.2_1.valid_at_ports)
      # 收窄成功判据: valid 只含一个口
      case "$v" in
        *" "*) : ;;      # 仍双口, 继续重试
        *) break ;;      # 单口, 成功
      esac
      k=$((k+1)); sleep 2
    done
  ) &
}

boot() { _do_map_when_ready; }
start_service() { _do_map_when_ready; }
stop_service() { :; }
