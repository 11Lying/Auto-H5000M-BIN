# ============================================================================
# ImmortalWrt H5000M 定制化配置（精简版，2026-10-07）
# 原则：够用就好，用不上的别留。
# ============================================================================

# --- 基础 ---
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-cbi=y
CONFIG_PACKAGE_luci-cbi=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_coreutils-sha1sum=y      # webuiserver 依赖
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_adb=y                    # 访问模组内部（刷机后仍需）
CONFIG_PACKAGE_nano=y

# --- 网络工具 ---
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_ethtool=y

# --- 硬件加速 / 风扇 ---
# 保留 turboacc（= HNAT 的 LuCI 开关）
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
# ★ 不要 luci-app-Airpifanctrl：它自带 /etc/init.d/Airpifanctrl + /usr/bin/fancts.sh
#   会和我们的 /usr/bin/fancontrol（CPU+WiFi 取高）**抢同一个 pwm1**。
#   本仓库的 local-build.sh / workflow 已相应改断言（改为校验 h5000m-kit）。
# CONFIG_PACKAGE_luci-app-Airpifanctrl is not set

# --- 代理：只要 OpenClash（不要 Nikki / MosDNS / PassWall / HomeProxy） ---
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_ruby=y                   # OpenClash 依赖
CONFIG_PACKAGE_ruby-yaml=y
# CONFIG_PACKAGE_nikki is not set
# CONFIG_PACKAGE_luci-app-nikki is not set
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set

# libwebsockets：必须显式选 full。QModem 新版 voipd 用条件依赖
# （已选 full 就用 full，否则 openssl），而 ttyd 依赖 libwebsockets-full；
# 两者只能共存于 full 形态。
CONFIG_PACKAGE_libwebsockets-full=y
# CONFIG_PACKAGE_libwebsockets-openssl is not set

# --- 模组：QModem（不用 modemmanager） ---
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_kmod-qmi_wwan_q=y
CONFIG_PACKAGE_kmod-pcie_mhi=y
# 注：modemmanager 保持**启用**。它对本机只是闲置体积（QModem 自己拨号），
# 但 fork 的 local-build.sh 里有硬校验 `verify_enabled_pkg "QModem ModemManager"`，
# 关掉会让 --config-only 直接中断。要省这 1.5MB 需同时改脚本+workflow，另议。
# CONFIG_PACKAGE_modemmanager=y   # ← 由 fork 默认逻辑保证，这里不写

# --- 家当：把我们的全部定制烤进固件 ---
CONFIG_PACKAGE_h5000m-kit=y

# --- 上游 defconfig 里这些别开（精简） ---
# CONFIG_PACKAGE_watchcat is not set
# CONFIG_PACKAGE_luci-app-ramfree is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-adblock is not set
# CONFIG_PACKAGE_luci-app-eqos-mtk is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set
# CONFIG_PACKAGE_yq is not set
# CONFIG_PACKAGE_xxd is not set
# CONFIG_PACKAGE_gawk is not set
# CONFIG_PACKAGE_pciutils is not set
# CONFIG_PACKAGE_coremark is not set
# CONFIG_PACKAGE_luci-app-wrtbwmon is not set
# CONFIG_PACKAGE_rclone is not set
# CONFIG_PACKAGE_luci-app-rclone is not set

# --- IPv6 netfilter 栈：我们没有 Nikki/HomeProxy，不需要 ip6tables 全家 ---
# （OpenClash 走 nft；ipv6 直连由 v6fastfail 的 nft 表处理）
# CONFIG_PACKAGE_kmod-ip6tables is not set
# CONFIG_PACKAGE_kmod-ip6tables-extra is not set
# CONFIG_PACKAGE_ip6tables-nft is not set
# CONFIG_PACKAGE_ip6tables-extra is not set
# CONFIG_PACKAGE_ip6tables-zz-legacy is not set
# CONFIG_PACKAGE_ip6tables-mod-nat is not set
# CONFIG_PACKAGE_libip6tc is not set
# CONFIG_PACKAGE_libip4tc2 is not set
CONFIG_PACKAGE_kmod-nf-ipt6=y            # OpenClash 的 fw4 规则仍需要
CONFIG_PACKAGE_kmod-ipt-nat6=y


# --- 明确挡住会造成冲突的两个上游包 -------------------------------
# feed 里另有一个 sendat（2024.01.22~…），会把我们的 AT 双口隔离 wrapper 换掉；
# h5000m-kit 自己提供 /bin/sendat（wrapper）+ /bin/sendat.real。
# CONFIG_PACKAGE_sendat is not set
# h5000m-kit 自带 /usr/bin/fancontrol + /etc/init.d/fancontrol（CPU+WiFi 取高）。
# CONFIG_PACKAGE_fancontrol is not set
# CONFIG_PACKAGE_luci-app-fancontrol is not set

# --- 编译 ---
CONFIG_CCACHE=y
# CONFIG_DEVEL is not set
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="github.actions"

# --- MTK WiFi / WED（H5000M 必须） ---
CONFIG_MTK_HWIFI_WED_SUPPORT=y
CONFIG_PACKAGE_kmod-mtk_wed=y
