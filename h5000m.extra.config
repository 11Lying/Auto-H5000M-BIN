# ============================================================================
# ImmortalWrt 25.12 + MTK Wi-Fi 7 SDK (r8) H5000M 定制化配置
# 基座：chasey-dev/immortalwrt-mt798x-rebase @ 25.12-dev-wifi7
#       (= ImmortalWrt 25.12 / 内核 6.12 / apk + MTK 闭源 Wi-Fi 7 驱动)
# Wi-Fi 相关内容全部在 config/h5000m-25.12.seed 里（MTK SDK 的 Kconfig 符号
# 跟着 SDK 版本走，整块保留，别按 24.10 基座的名字改）。本文件负责其余功能。
# ============================================================================

# --- 基础 ---
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ttyd=y                   # packages/utils/ttyd（SSH 抽风时的救命通道）
CONFIG_PACKAGE_adb=y                    # 主树 package/utils/adb，访问 RM502Q 内部
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_coreutils-sha1sum=y      # webuiserver 依赖
CONFIG_PACKAGE_unzip=y                  # OpenClash 依赖
CONFIG_PACKAGE_bash=y                   # OpenClash 依赖
CONFIG_PACKAGE_htop=y

# --- 网络工具 ---
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_ethtool=y

# --- 硬件加速 / 风扇 ------------------------------------------------------
# MTK SDK HNAT 仍在（kmod-mediatek_hnat / kmod-warp / WHNAT），LuCI 开关是
# luci-app-turboacc-mtk（在 seed 里选）。★注意：有 SDK HNAT 时 fw4 的
# flow_offloading 必须保持 0（跟主线 PPE offload 互斥），本仓库的
# uci-defaults 不动这个值 = 保持 OpenWrt 默认 0。
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
# 不要 luci-app-Airpifanctrl / luci-app-fancontrol-mtk / luci-app-mtk：
#   * luci-app-fancontrol-mtk 自带 /etc/init.d/fancontrol + /etc/config/fancontrol
#   * luci-app-Airpifanctrl 自带 /etc/init.d/Airpifanctrl + /usr/bin/fancts.sh
#   都会和我们自研的 /usr/bin/fancontrol（CPU+WiFi 取高）抢同一个 pwm1。
# luci-app-mtk 是 MTK 的 Lua SDK 页（含另一套风扇/无线页面），同样不要。
# CONFIG_PACKAGE_luci-app-Airpifanctrl is not set
# CONFIG_PACKAGE_luci-app-fancontrol-mtk is not set
# CONFIG_PACKAGE_luci-app-mtk is not set
# CONFIG_PACKAGE_luci-app-eqos-mtk is not set

# --- 代理：只要 OpenClash（不要 Nikki / MosDNS / PassWall / HomeProxy） ---
CONFIG_PACKAGE_luci-app-openclash=y     # 来自 immortalwrt/luci@openwrt-25.12 (0.47.156)
CONFIG_PACKAGE_ruby=y                   # OpenClash 依赖
CONFIG_PACKAGE_ruby-yaml=y              # ruby 包自动拆出的 stdlib 子包
CONFIG_PACKAGE_luci-compat=y            # OpenClash 依赖 Lua 兼容层
# CONFIG_PACKAGE_nikki is not set
# CONFIG_PACKAGE_luci-app-nikki is not set
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set

# --- 模组：QModem（厂商 QMI 驱动 + Tom 版 quectel-CM） ---------------------
# QModem feed 自带菜单（application/qmodem/Makefile 的 config 段），关键选项：
#   PACKAGE_qmodem_INCLUDE_vendor-qmi-wwan  → 编 kmod-qmi_wwan_q/_f/_s（默认）
#   PACKAGE_qmodem_USE_TOM_CUSTOMIZED_QUECTEL_CM → quectel-CM-5G-M（默认，我们用的）
#   PACKAGE_qmodem_INCLUDE_ndisc6           → IPv6 邻居发现（默认）
# ★ 千万不要同时选 immortalwrt/packages 的 quectel-qmi-wwan
#   （kmod-usb-net-qmi-wwan-quectel）—— 它和 QModem 的 kmod-qmi_wwan_q 生成
#   同名 qmi_wwan_q.ko，安装阶段会冲突。
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_qmodem_INCLUDE_vendor-qmi-wwan=y
CONFIG_PACKAGE_qmodem_USE_TOM_CUSTOMIZED_QUECTEL_CM=y
CONFIG_PACKAGE_qmodem_INCLUDE_SEAL=y
# CONFIG_PACKAGE_qmodem_INCLUDE_generic-qmi-wwan is not set
# CONFIG_PACKAGE_qmodem_INCLUDE_ADD_PCI_SUPPORT is not set
# CONFIG_PACKAGE_qmodem_INCLUDE_ADD_QFIREHOSE_SUPPORT is not set
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-quectel is not set
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-fibocom is not set
# CONFIG_PACKAGE_luci-app-qmodem is not set          # Lua 前端与 next 互斥
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y              # 通用 QMI（兜底/调试）
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
# kmod-pcie_mhi：25.12 上游没有这个包（旧 24.10 基座里它来自 padavanonly 的树），
# 我们走 USB QMI，不需要。

# --- 家当：把我们的全部定制烤进固件 ---
CONFIG_PACKAGE_h5000m-kit=y

# --- 精简 ---
# CONFIG_PACKAGE_modemmanager is not set         # QModem 自己拨号；省体积
# CONFIG_PACKAGE_luci-app-modem is not set       # 原版 modem 面板（与 QModem 抢同一栈）
# CONFIG_PACKAGE_watchcat is not set
# CONFIG_PACKAGE_luci-app-ramfree is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-adblock is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set
# CONFIG_PACKAGE_yq is not set
# CONFIG_PACKAGE_xxd is not set
# CONFIG_PACKAGE_gawk is not set
# CONFIG_PACKAGE_pciutils is not set
# CONFIG_PACKAGE_coremark is not set
# CONFIG_PACKAGE_rclone is not set
# CONFIG_PACKAGE_smartmontools is not set

# --- IPv6 netfilter 栈 ---------------------------------------------------
CONFIG_PACKAGE_kmod-nf-ipt6=y            # OpenClash 的 fw4 规则需要
CONFIG_PACKAGE_kmod-ipt-nat6=y

# --- 明确挡住会造成冲突的上游包 -----------------------------------------
# feed 里另有一个 sendat（2024.01.22~…），会把我们的 AT 双口隔离 wrapper 换掉；
# h5000m-kit 自己提供 /bin/sendat（wrapper）+ /bin/sendat.real。
# CONFIG_PACKAGE_sendat is not set
# h5000m-kit 自带 /usr/bin/fancontrol + /etc/init.d/fancontrol（CPU+WiFi 取高）。
# CONFIG_PACKAGE_fancontrol is not set

# --- 编译 ---------------------------------------------------------------
CONFIG_CCACHE=y
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="github.actions"
# 25.12 默认就用 apk 打包（config USE_APK default y），显式写死免得默认值变。
CONFIG_USE_APK=y
