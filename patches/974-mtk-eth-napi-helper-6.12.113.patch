From: H5000M build audit
Subject: [PATCH] net: ethernet: mediatek: keep NAPI cleanup helper for RSS

The upstream v6.12.113 kernel moved dummy-netdev and NAPI setup before
register_netdev(), so the original vendor 999-eth-07 move is redundant and
its old hunks conflict. The RSS patch 999-eth-09 still requires the shared
mtk_napi_del() helper to unregister its per-ring NAPI instances. Retain only
the helper/call-site refactor against the stable 6.12.113 probe order; the
original vendor patch is preserved outside the active queue.

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -4987,12 +4987,18 @@
 
 	mtk_wed_fe_reset_complete();
 
 	rtnl_unlock();
 }
 
+static void mtk_napi_del(struct mtk_eth *eth)
+{
+	netif_napi_del(&eth->tx_napi);
+	netif_napi_del(&eth->rx_napi);
+}
+
 static int mtk_free_dev(struct mtk_eth *eth)
 {
 	int i;
 
 	for (i = 0; i < MTK_MAX_DEVS; i++) {
 		if (!eth->netdev[i])
@@ -6340,14 +6346,13 @@
 	/* A netdev opened while probe was still registering can have queued
 	 * the frame-engine reset worker, which takes rtnl and drives the
 	 * hardware; cancel it before anything below is torn down.
 	 */
 	cancel_work_sync(&eth->pending_work);
 	if (eth->dummy_dev) {
-		netif_napi_del(&eth->tx_napi);
-		netif_napi_del(&eth->rx_napi);
+		mtk_napi_del(eth);
 		free_netdev(eth->dummy_dev);
 	}
 	mtk_ppe_deinit(eth);
 	mtk_release_all_muxes(eth);
 	mtk_mdio_cleanup(eth);
 err_free_dev:
@@ -6382,14 +6387,13 @@
 			mtk_usxgmii_pcs_put(mac->usxgmii_pcs);
 	}
 
 	mtk_wed_exit();
 	mtk_hw_deinit(eth);
 
-	netif_napi_del(&eth->tx_napi);
-	netif_napi_del(&eth->rx_napi);
+	mtk_napi_del(eth);
 	mtk_cleanup(eth);
 	free_netdev(eth->dummy_dev);
 	mtk_mdio_cleanup(eth);
 	mtk_release_all_muxes(eth);
 }
 
