 void mtk_mac_mib_update(struct mtk_mac *mac, struct mtk_hw_stats *prev,
 			struct mtk_hw_stats *cur)
 {
-	struct mtk_eth *eth = mac->hw;
+	struct mtk_eth *eth;
 
-	if (!mtk_is_netsys_v3_or_greater(eth))
+	if (!mac || !prev || !cur || !mac->hw ||
+	    mac->id < MTK_GMAC1_ID || mac->id >= MTK_GMAC_ID_MAX ||
+	    mac->id >= MTK_MAX_DEVS)
+		return;
+
+	eth = mac->hw;
+	if (!eth->soc || !mtk_is_netsys_v3_or_greater(eth))
 		return;
 
 	gmac_hw_stats[mac->id].tx_uc_packets +=
@@ -1160,24 +1171,51 @@
 static int mtk_eth_debugfs_mac_cnt_show(struct seq_file *m, void *v)
 {
 	struct mtk_eth *eth = m->private;
+	struct mtk_mac *mac;
+	struct mtk_hw_stats *hw_stats;
+	struct mtk_gmac_hw_stats stats;
+	unsigned long flags;
 	int i;
 
 	seq_puts(m, "+------------------------------------+\n");
 	seq_puts(m, "|              <<GMAC>>              |\n");
 
-	for (i = MTK_GMAC1_ID; i < MTK_GMAC_ID_MAX; i++) {
-		if (mtk_interface_mode_is_xgmii(eth->mac[i]->interface))
+	if (!eth || !eth->soc) {
+		seq_puts(m, "| Ethernet device unavailable       |\n");
+		goto out;
+	}
+
+	for (i = MTK_GMAC1_ID;
+	     i < MTK_GMAC_ID_MAX && i < ARRAY_SIZE(eth->mac); i++) {
+		mac = READ_ONCE(eth->mac[i]);
+		if (!mac || mac->id != i) {
+			seq_printf(m, "| MAC%d: not present                |\n", i + 1);
+			continue;
+		}
+
+		hw_stats = READ_ONCE(mac->hw_stats);
+		if (!hw_stats) {
+			seq_printf(m, "| MAC%d: statistics unavailable    |\n", i + 1);
+			continue;
+		}
+
+		if (mtk_interface_mode_is_xgmii(mac->interface))
 			continue;
 
-		spin_lock(&eth->mac[i]->hw_stats->stats_lock);
-		mtk_mac_mib_dump(m, i);
-		memset(&gmac_hw_stats[i], 0, sizeof(struct mtk_gmac_hw_stats));
-		spin_unlock(&eth->mac[i]->hw_stats->stats_lock);
+		/* The stats lock serializes mtk_mac_mib_update(). Copy and clear
+		 * under the lock, then format outside the critical section.
+		 */
+		spin_lock_irqsave(&hw_stats->stats_lock, flags);
+		stats = gmac_hw_stats[i];
+		memset(&gmac_hw_stats[i], 0, sizeof(gmac_hw_stats[i]));
+		spin_unlock_irqrestore(&hw_stats->stats_lock, flags);
+
+		mtk_mac_mib_dump(m, i, &stats);
 		seq_puts(m, "|                                    |\n");
 	}
 
+out:
 	seq_puts(m, "+------------------------------------+\n");
-
 	return 0;
 }
 
