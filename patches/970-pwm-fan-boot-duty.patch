--- a/drivers/hwmon/pwm-fan.c
+++ b/drivers/hwmon/pwm-fan.c
@@ -528,10 +528,24 @@
 	ctx->enable_mode = pwm_disable_reg_enable;
 
 	/*
-	 * Set duty cycle to maximum allowed and enable PWM output as well as
-	 * the regulator. In case of error nothing is changed
+	 * Set the initial duty cycle and enable PWM output as well as the
+	 * regulator. In case of error nothing is changed.
+	 *
+	 * Boards may request a quieter handover duty through the optional
+	 * "pwm-fan,boot-duty" device tree property (0..MAX_PWM). This only
+	 * changes the duty used while the thermal cooling levels take over;
+	 * it does not alter any cooling level or trip point.
 	 */
-	ret = set_pwm(ctx, MAX_PWM);
+	{
+		u32 boot_duty = MAX_PWM;
+
+		of_property_read_u32(dev->of_node, "pwm-fan,boot-duty",
+				     &boot_duty);
+		if (boot_duty > MAX_PWM)
+			boot_duty = MAX_PWM;
+
+		ret = set_pwm(ctx, boot_duty);
+	}
 	if (ret) {
 		dev_err(dev, "Failed to configure PWM: %d\n", ret);
 		return ret;
